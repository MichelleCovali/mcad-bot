DATABASE_URL=sqlite:///data/mcad.sqlite3
ADMIN_API_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:8090
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Private Telegram user IDs that may review reports (comma-separated). Empty denies all.
TELEGRAM_REVIEWER_IDS=
# Telegram buttons: keep disabled until tested with a separate bot and isolated DB.
ENABLE_TELEGRAM_REVIEW_BUTTONS=false
# Additionally opt in to structured, confirmed Telegram rejections (never approvals).
ENABLE_TELEGRAM_REJECTION_ACTIONS=false
# Opt in to private free-text rejection explanations. Also requires review and rejection gates.
ENABLE_TELEGRAM_REJECTION_NOTES=false
# Separately opt in to confirmed Telegram publication; never use with production while testing.
ENABLE_TELEGRAM_APPROVAL_ACTIONS=false
# Allows authorized private reviewers to correct category/method on pending AI candidates.
ENABLE_TELEGRAM_CLASSIFICATION_ACTIONS=false
# Preserve the existing bot's URL-only incident alerts. Rich alerts are opt-in.
TELEGRAM_MESSAGE_FORMAT=link
# Local development is quiet. The hosted service enables its workers explicitly.
ENABLE_BACKGROUND_WORKERS=false
ENABLE_FEED_POLLING=false
ENABLE_TELEGRAM_POLLING=false

# Paid AI search remains blocked even when an API key is present.
# Later activation requires BOTH this switch and the saved admin setting.
ENABLE_AI_SEARCH=false
OPENAI_API_KEY=
AI_DISCOVERY_MODEL=gpt-6-luna
AI_VERIFICATION_MODEL=gpt-6.1-sol
